# Copy this file to ~/.config/workspaces-host/credentials and fill in
# whatever you have - leave the rest blank, or delete lines you don't
# need. `workspaces-host-update` actually creates this file for you
# automatically, from this exact template, the first time you run it
# and none exists yet - so you may already have a real copy waiting for
# you at that path; this tracked copy is just the reference template.
#
# This is a plain KEY=value file, not Nix - nothing to install first.
# Just fill in the values below.
#
# Never commit this file (or your real copy of it) anywhere. Your real
# copy lives at ~/.config/workspaces-host/credentials, entirely outside
# this repository - `git pull`/`workspaces-host-update` never touch it -
# and `workspaces-host-update` sets it to mode 600 (readable only by
# you) every time it runs. Nix itself never reads this file directly;
# `workspaces-host-update` reads it, wires up your git identity,
# re-activates your profile, and finishes by running `doctor` to
# confirm it all worked.

# Your name and email, used for every git commit.
GIT_NAME=
GIT_EMAIL=
