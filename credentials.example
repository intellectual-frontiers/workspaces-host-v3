# `workspaces-host-update` creates ~/.config/workspaces-host/credentials from
# this exact template the first time you run it, so you likely already have a
# real copy there - this tracked file is just the reference. Plain KEY=value,
# not Nix - fill in what you have, leave the rest blank. Never commit your
# real copy; it lives outside this repository and stays that way. See the
# README's "Setting up your credentials" section for the full explanation.

# Your name and email, used for every git commit.
GIT_NAME=
GIT_EMAIL=

# A GitHub/GitLab personal access token (create one under Settings ->
# Developer settings on either site - a short-lived one, with an
# expiration date, is safer than a permanent one). Used by `gh`/`glab`,
# scoped to just that one command's invocation - never an ambient
# shell variable (see README's "Setting up your credentials" section).
GITHUB_TOKEN=
GITLAB_TOKEN=

# Anything else that needs a credential (a cloud provider token, a
# project-specific API key) can go here too, under whatever name makes
# sense - workspaces-host-update writes any line that isn't
# GIT_NAME/GIT_EMAIL into ~/.local/state/workspaces-host/secrets/env/<NAME>,
# ready for a project's own .envrc to pick up. See README for the
# exact pattern.
