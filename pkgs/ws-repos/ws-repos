#!/bin/sh
# ws-repos: governed multi-repo workspace management under $WORKSPACES_HOME.
#
# A native POSIX-shell port of strategy-coach/workspaces' mgit.ts/
# ws-ensure.ts "mGit" pattern (https://github.com/strategy-coach/workspaces)
# - the same <git-host>/<org>/.../<repo> directory convention, idempotent
# clone-or-pull, *.mgit.code-workspace symlinking with recursive
# dependent-repo resolution ("VS Code monorepo" composition), and a status
# report - as one dependency-free tool instead of a Deno script an
# engineer edits and re-runs by hand.
#
# Named "ws-repos" (not "mgit") to avoid confusion with unrelated
# third-party tools of that name; the *.mgit.code-workspace file suffix
# below is kept exactly as upstream's mgit.ts hardcodes it
# (strictVsCodeWsPathMatchers()), so files following that convention stay
# recognized regardless of which tool manages them.
set -u

WORKSPACES_HOME="${WORKSPACES_HOME:-$HOME/workspaces}"
WS_REPOS_CONFIG="${WS_REPOS_CONFIG:-$WORKSPACES_HOME/ws-repos.json}"
WS_REPOS_VSCODE_WS_PATTERN="${WS_REPOS_VSCODE_WS_PATTERN:-*.mgit.code-workspace}"

# Color only when it'll actually render as color: a real terminal, no
# NO_COLOR (https://no-color.org), and not the "dumb" fallback TERM - the
# same convention `doctor` uses, so every command in this repo behaves
# the same way when piped, redirected, or run under NO_COLOR=1.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    esc=$(printf '\033')
    c_reset="${esc}[0m"
    c_bold="${esc}[1m"
    c_dim="${esc}[2m"
    c_red="${esc}[31m"
    c_green="${esc}[32m"
    c_yellow="${esc}[33m"
    c_cyan="${esc}[36m"
    c_magenta="${esc}[35m"
else
    c_reset='' c_bold='' c_dim=''
    c_red='' c_green='' c_yellow='' c_cyan='' c_magenta=''
fi
c_bold_red="${c_bold}${c_red}"

usage() {
    cat <<EOF
${c_bold}Usage:${c_reset} ws-repos <command> [args...]

Commands:
  ensure                 Clone-or-update every repo in \$WS_REPOS_CONFIG into
                          \$WORKSPACES_HOME, following the
                          <git-host>/<org>/.../<repo> convention. Symlinks
                          any $WS_REPOS_VSCODE_WS_PATTERN files found inside
                          each repo to the workspace root, and recursively
                          ensures any repos referenced by that workspace
                          file's "folders" (VS Code multi-root "monorepo").
                          An existing clone is only ever fast-forwarded:
                          one with uncommitted changes, local commits that
                          diverge from upstream, or no upstream is left as
                          it was and named in the summary, and an adopted
                          checkout (below) is only fetched. Exits non-zero,
                          naming each repo and git's own reason, if any
                          clone or update fails.
  adopt [PATH]            Take a checkout opened outside \$WORKSPACES_HOME
                          (Codespaces and volume devcontainers always open
                          /workspaces/<repo>) into the layout instead of
                          cloning it a second time: links
                          \$WORKSPACES_HOME/<host>/<org>/<repo> to it, and
                          links every other configured repo beside it so
                          ../<repo> resolves. PATH defaults to the current
                          directory; a checkout not listed in
                          \$WS_REPOS_CONFIG is left alone.
  status [DEPTH]          Fetch and report git status (up to date/needs a
                          pull/dirty/ahead/untracked/no-upstream), plus a
                          stuck index.lock and stash count, across every
                          repo under \$WORKSPACES_HOME (DEPTH default 6,
                          deep enough for nested GitLab group/subgroup
                          layouts). Paths print relative to the current
                          directory. Fetches from each repo's upstream
                          first, so this is a network operation, unlike
                          ensure/inspect's own local-only reads once a repo
                          is cloned.
  inspect                 List the git managers (github.com, gitlab.*, ...)
                          and full repo list referenced by every
                          $WS_REPOS_VSCODE_WS_PATTERN file under
                          \$WORKSPACES_HOME.

Environment:
  WORKSPACES_HOME            Root of the managed workspace (default: \$HOME/workspaces)
  WS_REPOS_CONFIG            Repo list (default: \$WORKSPACES_HOME/ws-repos.json)
  WS_REPOS_VSCODE_WS_PATTERN find(1) -name pattern for workspace files
                             (default: *.mgit.code-workspace - upstream
                             mGit's own convention, unrelated to this
                             tool's own name)

Config file format (\$WS_REPOS_CONFIG):
  {
    "repos": [
      { "repo": "github.com/org/repo" },
      { "repo": "github.com/org/other-repo", "fresh": true }
    ]
  }

"fresh": true deletes and re-clones an already-cloned repo instead of
pulling. It is refused for a repo that is a symlink (an adopted
checkout): deleting the link would leave the real checkout and clone a
second copy, so that repo is fetched instead. Set NO_COLOR=1 to disable
status's color output.
EOF
}

HANDLED_FILE=$(mktemp)
SUMMARY_FILE=$(mktemp)
# One "<repo>\t<git's reason>" line per repo that failed to clone or
# pull. A file, not a variable: ensure_repo runs inside `jq | while`
# pipelines (subshells), where a variable set would never reach
# cmd_ensure's closing summary.
FAILED_FILE=$(mktemp)
# One "<repo>\t<why>" line per repo deliberately left as it was (spec
# 036): local work ensure must not touch. Not a failure.
SKIPPED_FILE=$(mktemp)
trap 'rm -f "$HANDLED_FILE" "$SUMMARY_FILE" "$FAILED_FILE" "$SKIPPED_FILE"' EXIT INT TERM

is_handled() {
    grep -qxF "$1" "$HANDLED_FILE" 2>/dev/null
}

mark_handled() {
    printf '%s\n' "$1" >>"$HANDLED_FILE"
}

# record_failure REPO REASON: remembers a failed clone/pull for
# cmd_ensure's summary and exit status. $WS_REPOS_FAILED_FILE, when set,
# also gets the bare repo name - how ws-start names the failures in its
# own summary without parsing this tool's output.
record_failure() {
    printf '%s\t%s\n' "$1" "$2" >>"$FAILED_FILE"
    if [ -n "${WS_REPOS_FAILED_FILE:-}" ]; then
        printf '%s\n' "$1" >>"$WS_REPOS_FAILED_FILE"
    fi
}

# record_skip REPO WHY: a repo ensure left alone on purpose, for the
# closing summary; $WS_REPOS_SKIPPED_FILE gets "<repo>: <why>" for
# ws-start's own summary, the same way $WS_REPOS_FAILED_FILE does.
record_skip() {
    echo "ws-repos: $1: $2" >&2
    printf '%s\t%s\n' "$1" "$2" >>"$SKIPPED_FILE"
    if [ -n "${WS_REPOS_SKIPPED_FILE:-}" ]; then
        printf '%s: %s\n' "$1" "$2" >>"$WS_REPOS_SKIPPED_FILE"
    fi
}

# update_repo REPO ABS: bring an existing clone up to date without ever
# risking local work (spec 036). `git pull` was wrong here: this
# profile's git config makes it a rebase with autostash, so a reattach
# with unpushed commits that conflicted upstream left the working copy
# mid-rebase. Instead: fetch, then fast-forward only, and only when the
# working tree is clean and the branch hasn't diverged. Anything else is
# reported and left exactly as it was.
update_repo() {
    ur_repo="$1"
    ur_abs="$2"
    # A symlinked repo is an adopted checkout - the working copy an
    # editor opened and someone is editing right now. Fetch it so
    # `status` is current; never touch its working tree or branch.
    if [ -L "$ur_abs" ]; then
        echo "ws-repos: $ur_repo is the checkout the editor opened ($(readlink "$ur_abs")) - fetching only" >&2
        if run_git "$ur_repo" fetch -C "$ur_abs" fetch --quiet; then
            record_skip "$ur_repo" "the checkout the editor opened - fetched, working tree not updated"
            return 0
        fi
        return 1
    fi
    if [ -n "$(git -C "$ur_abs" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        record_skip "$ur_repo" "has uncommitted changes, not updated"
        return 0
    fi
    run_git "$ur_repo" fetch -C "$ur_abs" fetch --quiet || return 1
    if ! git -C "$ur_abs" rev-parse --verify --quiet '@{u}' >/dev/null 2>&1; then
        record_skip "$ur_repo" "no upstream branch (detached HEAD, or a branch that tracks nothing), not updated"
        return 0
    fi
    ur_counts=$(git -C "$ur_abs" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || printf '0\t0')
    ur_behind=$(printf '%s' "$ur_counts" | cut -f1)
    ur_ahead=$(printf '%s' "$ur_counts" | cut -f2)
    if [ "$ur_behind" = 0 ]; then
        return 0
    fi
    if [ "$ur_ahead" != 0 ]; then
        record_skip "$ur_repo" "has $ur_ahead local commit(s) and is $ur_behind behind upstream (diverged), not updated"
        return 0
    fi
    # Fast-forward only: git refuses rather than merging, and refuses
    # rather than overwriting an untracked file, leaving the tree as is.
    run_git "$ur_repo" fast-forward -C "$ur_abs" merge --ff-only --quiet '@{u}'
}

# run_git REPO WHAT GIT_ARGS...: runs git, passing its stderr through
# (indented) so its own reason is visible where it happened, and on
# failure records that reason - every non-blank stderr line, joined -
# rather than a guess at the cause: "could not read Username" (no
# login), "Repository not found" (no access, or a typo) and "Could not
# resolve host" (offline) each need a different fix.
run_git() {
    rg_repo="$1"
    rg_what="$2"
    shift 2
    rg_err=$(mktemp)
    if git "$@" 2>"$rg_err"; then
        sed 's/^/ws-repos:     /' "$rg_err" >&2
        rm -f "$rg_err"
        return 0
    fi
    sed 's/^/ws-repos:     /' "$rg_err" >&2
    rg_reason=$(grep -v '^[[:space:]]*$' "$rg_err" | paste -sd ' ' -)
    rm -f "$rg_err"
    [ -n "$rg_reason" ] || rg_reason="git exited non-zero with no message"
    echo "ws-repos: $rg_what failed for $rg_repo: $rg_reason" >&2
    record_failure "$rg_repo" "$rg_what failed: $rg_reason"
    return 1
}

# repo_id_from_url URL: <host>/<org>/.../<repo> from a git remote URL -
# https with or without credentials ("https://x-access-token:...@host/..."),
# ssh:// (port dropped), or scp-style "git@host:org/repo" - the same
# names ensure clones under $WORKSPACES_HOME. Parameter expansion only.
repo_id_from_url() {
    u="${1%/}"
    u="${u%.git}"
    case "$u" in
    *://*)
        u="${u#*://}"
        case "${u%%/*}" in *@*) u="${u#*@}" ;; esac
        ;;
    *@*:*)
        u="${u#*@}"
        u="${u%%:*}/${u#*:}"
        ;;
    esac
    host="${u%%/*}"
    printf '%s/%s\n' "${host%:*}" "${u#*/}"
}

# physical_path PATH: PATH with every symlink resolved, the final
# component included (empty if it doesn't exist).
physical_path() {
    if [ -d "$1" ]; then
        (cd "$1" 2>/dev/null && pwd -P)
    fi
}

# list_repo_dirs DEPTH: every repo under $WORKSPACES_HOME, one path per
# line. A plain `find -name .git` never descends through a symlink, and
# an adopted checkout (cmd_adopt) is exactly that - so every symlink that
# is itself a repo is listed too, without following links any further
# (so no loop to guard against).
list_repo_dirs() {
    {
        find "$WORKSPACES_HOME" -maxdepth "$1" -name .git -type d 2>/dev/null | while IFS= read -r gitdir; do
            dirname "$gitdir"
        done
        list_repo_links "$1"
    } | sort -u
}

# list_repo_links DEPTH: just the symlinked repos list_repo_dirs adds.
list_repo_links() {
    find "$WORKSPACES_HOME" -maxdepth "$1" -type l 2>/dev/null | while IFS= read -r link; do
        if [ -d "$link/.git" ]; then
            printf '%s\n' "$link"
        fi
    done
}

# strip_jsonc FILE: a best-effort JSONC -> JSON filter (drops whole-line
# "//" comments and "/* ... */" block comments) so `jq` can read a VS Code
# *.code-workspace file even when it has the comments VS Code itself
# allows there - upstream mgit.ts parses these with a real JSONC parser
# (Deno's std jsonc module); reaching for a runtime dependency just for
# this would undo the whole point of this being a dependency-free POSIX
# port, so this covers the common cases (a comment on its own line, or a
# block comment) rather than tokenizing strings byte-by-byte. A "//" or
# "/*" that appears inside a JSON string value is a real, if rare, blind
# spot - see spec 003's Assumptions.
strip_jsonc() {
    sed -E 's#^[[:space:]]*//.*$##' "$1" | sed -E ':a;N;$!ba; s#/\*[^*]*\*+([^/*][^*]*\*+)*/##g'
}

# resolve_workspace_deps ABS_REPO_PATH
# Finds *.mgit.code-workspace files inside a just-cloned/pulled repo,
# symlinks each to the workspace root, and recursively ensures every repo
# referenced by that file's .folders[].path - "." means "this same repo"
# (upstream mgit.ts's own convention for a workspace file that includes
# its own containing repo as one of its folders), so it's recognized and
# skipped rather than passed through as a literal path.
resolve_workspace_deps() {
    abs="$1"
    # "$abs/", not "$abs": find does not descend into a starting point
    # that is itself a symlink (an adopted checkout) without it. `-s`
    # keeps the link's logical path, so the workspace-file link points
    # through $WORKSPACES_HOME/<host>/<org>/<repo>, not around it.
    find "$abs/" -type f -name "$WS_REPOS_VSCODE_WS_PATTERN" 2>/dev/null | while IFS= read -r wsfile; do
        name=$(basename "$wsfile")
        target="$WORKSPACES_HOME/$name"
        rel=$(realpath -s --relative-to="$WORKSPACES_HOME" "$wsfile")
        echo "ws-repos:   symlinking $name -> $rel" >&2
        rm -f "$target"
        ln -s "$rel" "$target"

        strip_jsonc "$wsfile" | jq -r '.folders[]?.path // empty' 2>/dev/null | while IFS= read -r dep; do
            [ -n "$dep" ] || continue
            [ "$dep" = "." ] && continue
            ensure_repo "$dep" "false"
        done
    done
}

# ensure_repo REPO_PATH FRESH
ensure_repo() {
    repo_path="$1"
    fresh="$2"
    abs="$WORKSPACES_HOME/$repo_path"

    is_handled "$abs" && return 0
    mark_handled "$abs"

    if [ -d "$abs" ]; then
        if [ "$fresh" = "true" ] && [ -L "$abs" ]; then
            # `rm -rf` on the link would remove only the link, and the
            # clone below would then make the second copy adopt exists
            # to prevent - so refuse, and pull the real checkout instead.
            echo "ws-repos: $repo_path is a link to $(readlink "$abs") (an adopted checkout) - refusing \"fresh\", which would delete only the link and clone a second copy; updating it instead (re-clone $(readlink "$abs") yourself if you need a fresh copy)" >&2
            fresh=false
        fi
        if [ "$fresh" = "true" ]; then
            echo "ws-repos: $repo_path found, forcing re-clone (removing $abs)" >&2
            rm -rf "$abs"
        else
            echo "ws-repos: $repo_path found, updating (fast-forward only)" >&2
            if update_repo "$repo_path" "$abs"; then
                resolve_workspace_deps "$abs"
            fi
            return 0
        fi
    fi

    mkdir -p "$(dirname "$abs")"
    echo "ws-repos: $repo_path not found, cloning" >&2
    if run_git "$repo_path" clone clone --quiet "https://$repo_path" "$abs"; then
        resolve_workspace_deps "$abs"
    fi
}

cmd_ensure() {
    [ -f "$WS_REPOS_CONFIG" ] || {
        echo "ws-repos: no config at $WS_REPOS_CONFIG - see 'ws-repos --help' for the format" >&2
        exit 1
    }
    mkdir -p "$WORKSPACES_HOME"
    entries=$(jq -c '.repos[]' "$WS_REPOS_CONFIG") || {
        echo "ws-repos: could not read .repos[] from $WS_REPOS_CONFIG - see 'ws-repos --help' for the format" >&2
        exit 1
    }
    printf '%s\n' "$entries" | while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        repo=$(printf '%s' "$entry" | jq -r '.repo')
        fresh=$(printf '%s' "$entry" | jq -r '.fresh // false')
        ensure_repo "$repo" "$fresh"
    done

    if [ -s "$SKIPPED_FILE" ]; then
        echo "ws-repos ensure: $(wc -l <"$SKIPPED_FILE" | tr -d ' ') repo(s) left as they were:" >&2
        while IFS="$(printf '\t')" read -r repo why; do
            echo "ws-repos ensure:   - $repo: $why" >&2
        done <"$SKIPPED_FILE"
    fi
    if [ -s "$FAILED_FILE" ]; then
        echo "ws-repos ensure: $(wc -l <"$FAILED_FILE" | tr -d ' ') repo(s) failed:" >&2
        while IFS="$(printf '\t')" read -r repo reason; do
            echo "ws-repos ensure:   - $repo: $reason" >&2
        done <"$FAILED_FILE"
        exit 1
    fi
    echo "ws-repos ensure: ok" >&2
}

# cmd_adopt [PATH]: see usage. Only shell, git and jq, so it works in an
# image with nothing else; idempotent, and it never moves, deletes or
# clones anything - it only adds links where nothing exists yet.
cmd_adopt() {
    [ -f "$WS_REPOS_CONFIG" ] || {
        echo "ws-repos adopt: no config at $WS_REPOS_CONFIG - see 'ws-repos --help' for the format" >&2
        exit 1
    }
    start="${1:-$PWD}"
    here=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null) || {
        echo "ws-repos adopt: $start is not inside a git checkout" >&2
        exit 1
    }
    here=$(physical_path "$here")
    url=$(git -C "$here" remote get-url origin 2>/dev/null) || {
        echo "ws-repos adopt: $here has no 'origin' remote to name it by" >&2
        exit 1
    }
    self=$(repo_id_from_url "$url")
    if ! jq -e --arg r "$self" 'any(.repos[]; .repo == $r)' "$WS_REPOS_CONFIG" >/dev/null 2>&1; then
        echo "ws-repos adopt: $self ($here) is not listed in $WS_REPOS_CONFIG - nothing to adopt" >&2
        return 0
    fi
    canonical="$WORKSPACES_HOME/$self"

    # The checkout already lives at its own place in the layout (its
    # parent resolved physically, the last component not, so a link
    # *at* that place doesn't count): nothing to do.
    if [ "$(physical_path "$(dirname "$canonical")")/$(basename "$canonical")" = "$here" ]; then
        echo "ws-repos adopt: $here is already $canonical - nothing to do" >&2
        return 0
    fi

    if [ -L "$canonical" ] && [ "$(physical_path "$canonical")" = "$here" ]; then
        echo "ws-repos adopt: $canonical already links to $here" >&2
    elif [ -e "$canonical" ] || [ -L "$canonical" ]; then
        echo "ws-repos adopt: $canonical already exists and is not a link to $here - leaving both alone (ensure will pull that one, not this checkout)" >&2
    else
        mkdir -p "$(dirname "$canonical")"
        ln -s "$here" "$canonical"
        echo "ws-repos adopt: $canonical -> $here" >&2
    fi

    # Links go from beside the checkout into the layout, not the other
    # way round: tools resolve "../<repo>" against the checkout's
    # physical path, so the link has to exist there.
    parent=$(dirname "$here")
    jq -r '.repos[].repo' "$WS_REPOS_CONFIG" | while IFS= read -r repo; do
        [ -n "$repo" ] && [ "$repo" != "$self" ] || continue
        beside="$parent/${repo##*/}"
        if [ -L "$beside" ] && [ "$(readlink "$beside")" = "$WORKSPACES_HOME/$repo" ]; then
            continue
        elif [ -e "$beside" ] || [ -L "$beside" ]; then
            echo "ws-repos adopt: $beside already exists - leaving it alone" >&2
        else
            ln -s "$WORKSPACES_HOME/$repo" "$beside"
            echo "ws-repos adopt: $beside -> $WORKSPACES_HOME/$repo" >&2
        fi
    done
}

# report_repo_status ABS_REPO_PATH: prints one colored status line for a
# repo, and appends its bucket (up-to-date/needs-pull/attention) to
# $SUMMARY_FILE for cmd_status's closing tally.
report_repo_status() {
    repo="$1"
    display_path=$(realpath -s --relative-to="$PWD" "$repo" 2>/dev/null || printf '%s' "$repo")
    branch=$(git -C "$repo" symbolic-ref --short -q HEAD || echo "(detached)")

    locked=false
    # A stuck index.lock (a crashed/killed git process) blocks every other
    # git command in that repo until removed by hand - worth its own flag
    # rather than folding it into "dirty" (upstream mgit.ts's mGitStatus
    # reports this as "Locked" too).
    [ -f "$repo/.git/index.lock" ] && locked=true

    dirty=false
    untracked=false
    porcelain=$(git -C "$repo" status --porcelain 2>/dev/null)
    if [ -n "$porcelain" ]; then
        # Distinguish modified/staged tracked files ("dirty") from
        # untracked-only ("untracked") the same way upstream reports
        # "Uncommitted changes" and "Untracked files" separately, rather
        # than folding both into one flag.
        printf '%s\n' "$porcelain" | grep -qv '^??' && dirty=true
        printf '%s\n' "$porcelain" | grep -q '^??' && untracked=true
    fi

    ahead=0
    behind=0
    no_upstream=false
    fetch_failed=false
    upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [ -z "$upstream" ]; then
        no_upstream=true
    else
        # A plain `rev-list` against the local copy of the upstream ref
        # only reflects the last time *something* happened to fetch it -
        # it can claim "up to date" for a branch that's actually several
        # commits behind on the real remote. Fetching first is what makes
        # "needs a pull" trustworthy instead of stale.
        git -C "$repo" fetch --quiet 2>/dev/null || fetch_failed=true
        counts=$(git -C "$repo" rev-list --left-right --count "$upstream...HEAD" 2>/dev/null || printf '0\t0')
        behind=$(printf '%s' "$counts" | cut -f1)
        ahead=$(printf '%s' "$counts" | cut -f2)
    fi

    stash_count=$(git -C "$repo" stash list 2>/dev/null | wc -l | tr -d ' ')

    flags=""
    add_flag() { flags="${flags:+$flags, }$1"; }
    [ "$locked" = true ] && add_flag "${c_bold_red}locked${c_reset}"
    [ "$dirty" = true ] && add_flag "${c_red}dirty${c_reset}"
    [ "$untracked" = true ] && add_flag "${c_magenta}untracked${c_reset}"
    [ "$behind" != "0" ] && add_flag "${c_yellow}$behind behind${c_reset}"
    [ "$ahead" != "0" ] && add_flag "${c_cyan}$ahead ahead${c_reset}"
    [ "$no_upstream" = true ] && add_flag "${c_dim}no-upstream${c_reset}"
    [ "$fetch_failed" = true ] && add_flag "${c_dim}fetch failed (offline?)${c_reset}"
    [ "$stash_count" != "0" ] && add_flag "${c_magenta}$stash_count stash(es)${c_reset}"

    # One leading icon per line, in priority order, so a long status list
    # can be scanned by eye without reading every word - and one bucket
    # per repo for the closing tally cmd_status prints. Literal UTF-8
    # emoji in the source (not \xHH printf escapes, which aren't portable
    # across every printf(1)), same as doctor's literal PASS/WARN/FAIL
    # icons.
    if [ -z "$flags" ]; then
        icon="✅"
        flags="${c_green}up to date${c_reset}"
        bucket="up-to-date"
    elif [ "$fetch_failed" = true ]; then
        icon="❓"
        bucket="attention"
    elif [ "$locked" = true ]; then
        icon="🔒"
        bucket="attention"
    elif [ "$dirty" = true ]; then
        icon="🔴"
        bucket="attention"
    elif [ "$behind" != "0" ]; then
        icon="⬇️"
        bucket="needs-pull"
    elif [ "$untracked" = true ]; then
        icon="🟡"
        bucket="attention"
    elif [ "$ahead" != "0" ]; then
        icon="⬆️"
        bucket="attention"
    else
        icon="⚪"
        bucket="attention"
    fi

    printf '%s\n' "$bucket" >>"$SUMMARY_FILE"

    # Pad the plain path first, then wrap it in color - padding a string
    # that already contains invisible ANSI escapes counts those bytes
    # toward the width and throws off every column after it.
    padded_path=$(printf '%-45s' "$display_path")
    printf '%s %s%s%s [%s%s%s] %s\n' \
        "$icon" "$c_bold" "$padded_path" "$c_reset" "$c_bold" "$branch" "$c_reset" "$flags"
}

cmd_status() {
    depth="${1:-6}"
    : >"$SUMMARY_FILE"
    list_repo_dirs "$depth" | while IFS= read -r repo_dir; do
        report_repo_status "$repo_dir"
    done

    total=$(wc -l <"$SUMMARY_FILE" | tr -d ' ')
    [ "$total" -gt 0 ] || return 0
    up_to_date=$(grep -c '^up-to-date$' "$SUMMARY_FILE" || true)
    needs_pull=$(grep -c '^needs-pull$' "$SUMMARY_FILE" || true)
    attention=$(grep -c '^attention$' "$SUMMARY_FILE" || true)
    printf '\n%s%d repo(s):%s %s✅ %d up to date%s   %s⬇️  %d need a pull%s   %s⚠ %d need attention%s\n' \
        "$c_bold" "$total" "$c_reset" \
        "$c_green" "$up_to_date" "$c_reset" \
        "$c_yellow" "$needs_pull" "$c_reset" \
        "$c_magenta" "$attention" "$c_reset"
}

cmd_inspect() {
    repos=$(mktemp)
    # Symlinked (adopted) repos searched explicitly, same reason as
    # list_repo_dirs.
    {
        find "$WORKSPACES_HOME" -type f -name "$WS_REPOS_VSCODE_WS_PATTERN" 2>/dev/null
        list_repo_links 6 | while IFS= read -r link; do
            find "$link/" -type f -name "$WS_REPOS_VSCODE_WS_PATTERN" 2>/dev/null
        done
    } | while IFS= read -r wsfile; do
        # "." means "the repo this workspace file itself lives in"
        # (upstream mgit.ts's own convention) - resolve it to that repo's
        # actual path instead of reporting the literal ".".
        self_repo=$(dirname "$(realpath -s --relative-to="$WORKSPACES_HOME" "$wsfile")")
        strip_jsonc "$wsfile" | jq -r '.folders[]?.path // empty' 2>/dev/null | while IFS= read -r p; do
            [ "$p" = "." ] && p="$self_repo"
            printf '%s\n' "$p"
        done
    done | sort -u >"$repos"

    echo "Git Managers:"
    cut -d/ -f1 "$repos" | sort -u | sed 's/^/  - /'
    echo "All ws-repos repos referenced by $WS_REPOS_VSCODE_WS_PATTERN files:"
    sed 's/^/  - /' "$repos"
    rm -f "$repos"
}

[ $# -ge 1 ] || {
    usage >&2
    exit 1
}
cmd="$1"
shift
case "$cmd" in
ensure) cmd_ensure "$@" ;;
adopt) cmd_adopt "$@" ;;
status) cmd_status "$@" ;;
inspect) cmd_inspect "$@" ;;
-h | --help) usage ;;
*)
    echo "ws-repos: unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
