#!/bin/sh
# sensitivectl: backup/restore named local directories to/from rclone
# remotes, driven by a small declarative JSON config.
set -eu

CONFIG="${SENSITIVECTL_CONFIG:-$HOME/.config/workspaces-host/sensitivectl.json}"

# Color only when it'll actually render as color: a real terminal, no
# NO_COLOR (https://no-color.org), and not the "dumb" fallback TERM -
# gated on stderr, since every human-facing message here goes there
# (list's profile-name output on stdout stays plain, meant for scripting).
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    esc=$(printf '\033')
    c_reset="${esc}[0m"
    c_bold="${esc}[1m"
    c_red="${esc}[31m"
    c_cyan="${esc}[36m"
else
    c_reset='' c_bold='' c_red='' c_cyan=''
fi

usage() {
    cat <<EOF
${c_bold}Usage:${c_reset} sensitivectl <command> [profile] [-- rclone-args...]

Commands:
  list                    List configured profiles
  backup <profile>        rclone sync <local> -> <remote> for that profile
  restore <profile>       rclone sync <remote> -> <local> for that profile

Config file (default: \$SENSITIVECTL_CONFIG or
~/.config/workspaces-host/sensitivectl.json):
  {
    "profiles": {
      "my-profile": { "local": "/home/me/Sensitive", "remote": "myremote:backups/sensitive" }
    }
  }

Anything after "--" is passed straight through to rclone (e.g. --dry-run).
EOF
}

require_config() {
    if [ ! -f "$CONFIG" ]; then
        echo "${c_red}sensitivectl: no config at $CONFIG (set SENSITIVECTL_CONFIG or create it)${c_reset}" >&2
        exit 1
    fi
}

profile_field() {
    profile="$1"
    field="$2"
    jq -r --arg p "$profile" --arg f "$field" '.profiles[$p][$f] // empty' "$CONFIG"
}

case "${1:-}" in
    "")
        usage >&2
        exit 1
        ;;
    -h|--help)
        usage
        exit 0
        ;;
esac

COMMAND="$1"; shift

case "$COMMAND" in
    list)
        require_config
        jq -r '.profiles | keys[]' "$CONFIG"
        ;;
    backup|restore)
        [ $# -ge 1 ] || { echo "${c_red}sensitivectl: $COMMAND requires a profile name${c_reset}" >&2; exit 1; }
        PROFILE="$1"; shift
        if [ "${1:-}" = "--" ]; then shift; fi
        require_config

        LOCAL=$(profile_field "$PROFILE" local)
        REMOTE=$(profile_field "$PROFILE" remote)

        if [ -z "$LOCAL" ] || [ -z "$REMOTE" ]; then
            echo "${c_red}sensitivectl: profile '$PROFILE' not found (or missing local/remote) in $CONFIG${c_reset}" >&2
            exit 1
        fi

        if [ "$COMMAND" = "backup" ]; then
            echo "${c_cyan}📤 sensitivectl: backing up $LOCAL -> $REMOTE${c_reset}" >&2
            rclone sync "$LOCAL" "$REMOTE" "$@"
        else
            echo "${c_cyan}📥 sensitivectl: restoring $REMOTE -> $LOCAL${c_reset}" >&2
            rclone sync "$REMOTE" "$LOCAL" "$@"
        fi
        ;;
    *)
        echo "${c_red}sensitivectl: unknown command: $COMMAND${c_reset}" >&2
        usage >&2
        exit 1
        ;;
esac
