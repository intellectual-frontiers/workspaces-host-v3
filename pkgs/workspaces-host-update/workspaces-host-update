#!/bin/sh
# workspaces-host-update: pull the latest workspaces-host-v3, wire up
# your credentials file (git identity, tokens - see
# ~/.config/workspaces-host/credentials and README's "Setting up your
# credentials" section), re-activate, and check everything is OK. One
# command instead of remembering "cd, git pull, edit some Nix,
# home-manager switch --flake ..., doctor".
set -eu

# Color only when it'll actually render as color: a real terminal, no
# NO_COLOR (https://no-color.org), and not the "dumb" fallback TERM -
# same convention as doctor/ws-repos. Every message here goes to stderr.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    esc=$(printf '\033')
    c_reset="${esc}[0m"
    c_bold="${esc}[1m"
    c_red="${esc}[31m"
    c_green="${esc}[32m"
    c_yellow="${esc}[33m"
    c_cyan="${esc}[36m"
else
    c_reset='' c_bold='' c_red='' c_green='' c_yellow='' c_cyan=''
fi

# Some shells/environments don't export $USER even though `whoami` works
# - the `current` profile below needs it to pick up your real identity
# instead of the fixed "workspace" test identity.
: "${USER:=$(whoami)}"
export USER

REPO="${WORKSPACES_HOST_REPO:-$HOME/.workspaces-host-v3}"
PROFILE="${WORKSPACES_HOST_PROFILE:-current}"

if [ ! -d "$REPO/.git" ]; then
    cat >&2 <<EOF
${c_red}workspaces-host-update: no git repo at $REPO${c_reset}

Set WORKSPACES_HOST_REPO to wherever you cloned workspaces-host-v3 (e.g.
in your bash config: export WORKSPACES_HOST_REPO=~/path/to/workspaces-host-v3),
or clone it to the default location:
  git clone https://github.com/intellectual-frontiers/workspaces-host-v3.git "$REPO"
EOF
    exit 1
fi

echo "${c_cyan}🔄 workspaces-host-update: pulling $REPO ...${c_reset}" >&2
git -C "$REPO" pull --ff-only

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CREDENTIALS_FILE="$CONFIG_HOME/workspaces-host/credentials"
SECRETS_DIR="$STATE_HOME/workspaces-host/secrets"
SECRETS_ENV_DIR="$SECRETS_DIR/env"
GIT_IDENTITY_FILE="$CONFIG_HOME/workspaces-host/git-identity"

# First run: hand the engineer a template to fill in, rather than
# silently proceeding with no identity configured. Copied from this
# checkout, not embedded here twice, so it can never drift from
# credentials.example.
if [ ! -f "$CREDENTIALS_FILE" ]; then
    mkdir -p "$(dirname "$CREDENTIALS_FILE")"
    cp "$REPO/credentials.example" "$CREDENTIALS_FILE"
    chmod 600 "$CREDENTIALS_FILE"
    cat >&2 <<EOF

${c_yellow}📝 workspaces-host-update: created $CREDENTIALS_FILE${c_reset}

Open it and fill in your name and email (leave the rest blank) - then
run workspaces-host-update again.
EOF
    exit 0
fi

# Defensive, not optional: re-assert mode 600 every run, in case an
# editor, a backup tool, or an inherited umask loosened it.
chmod 600 "$CREDENTIALS_FILE"

echo "${c_cyan}🔑 workspaces-host-update: reading $CREDENTIALS_FILE ...${c_reset}" >&2
mkdir -p "$SECRETS_ENV_DIR"
chmod 700 "$SECRETS_DIR" "$SECRETS_ENV_DIR"

git_name=""
git_email=""

# Tracks which keys this run actually wrote, so a key that was removed
# (or blanked) from the credentials file can be told apart from one
# that's simply still there - see the cleanup pass below. Named with a
# leading "." so the cleanup pass's own "$SECRETS_ENV_DIR"/* glob never
# matches it.
written_keys_file="$SECRETS_ENV_DIR/.written-this-run.$$"
: >"$written_keys_file"

# Plain KEY=value parsing, deliberately not `. "$CREDENTIALS_FILE"` -
# this file is edited by hand and might contain a stray `` ` `` or
# `$(...)` in a token; sourcing it as shell would execute that. "#"
# starts a comment, blank lines are skipped, and anything that isn't a
# bare KEY=value line is silently ignored rather than erroring, so a
# beginner's typo in this file can't break their whole sandbox.
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    '' | '#'*) continue ;;
    *=*) ;;
    *) continue ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
    *[!A-Za-z0-9_]* | '') continue ;;
    esac
    # Strip one layer of matching quotes, since many people instinctively
    # write KEY="a value with spaces" dotenv-style.
    case "$value" in
    \"*\") value=${value#\"} value=${value%\"} ;;
    \'*\') value=${value#\'} value=${value%\'} ;;
    esac
    [ -n "$value" ] || continue
    case "$key" in
    GIT_NAME) git_name="$value" ;;
    GIT_EMAIL) git_email="$value" ;;
    *)
        umask 077
        printf '%s' "$value" >"$SECRETS_ENV_DIR/$key.tmp"
        mv "$SECRETS_ENV_DIR/$key.tmp" "$SECRETS_ENV_DIR/$key"
        echo "$key" >>"$written_keys_file"
        ;;
    esac
done <"$CREDENTIALS_FILE"

# Remove any credential this directory still has on disk but that
# wasn't written just now - a key removed or blanked out in the
# credentials file otherwise keeps being read by every wrapped CLI
# (see home/ai-harness.nix) indefinitely, with nothing in the
# credentials file itself to show that's happening. This directory is
# also where home/secrets.nix's opt-in sops mechanism decrypts its own
# secrets, at every `home-manager switch` (below) - not just this
# script's own keys - so a sops-managed file swept up here is simply
# re-decrypted a few lines from now, before anything else runs.
for existing in "$SECRETS_ENV_DIR"/*; do
    [ -e "$existing" ] || continue
    name=$(basename "$existing")
    if ! grep -qxF "$name" "$written_keys_file"; then
        rm -f "$existing"
    fi
done
rm -f "$written_keys_file"

# home/git.nix's `programs.git.includes` points here unconditionally -
# git silently ignores an `[include] path` that doesn't exist, so this
# file simply not existing yet (nothing filled in) is a normal, harmless
# state, not an error.
mkdir -p "$(dirname "$GIT_IDENTITY_FILE")"
if [ -n "$git_name" ] || [ -n "$git_email" ]; then
    {
        echo "[user]"
        [ -n "$git_name" ] && printf '\tname = %s\n' "$git_name"
        [ -n "$git_email" ] && printf '\temail = %s\n' "$git_email"
    } >"$GIT_IDENTITY_FILE"
    chmod 600 "$GIT_IDENTITY_FILE"
fi

# For plain "current" (the common case), name which personas
# `ws-persona activate` has recorded - flake.nix's `current` build
# combines all of them, so it's worth being explicit about what's
# about to happen rather than leaving it implicit.
if [ "$PROFILE" = "current" ]; then
    personas_file="${XDG_CONFIG_HOME:-$HOME/.config}/workspaces-host/personas"
    active_personas=""
    if [ -f "$personas_file" ]; then
        active_personas=$(grep -v '^[[:space:]]*#' "$personas_file" 2>/dev/null | grep -v '^[[:space:]]*$' | tr '\n' ' ')
    fi
    if [ -n "$active_personas" ]; then
        echo "${c_cyan}🏗️  workspaces-host-update: switching to $PROFILE (personas: $active_personas)...${c_reset}" >&2
    else
        echo "${c_cyan}🏗️  workspaces-host-update: switching to $PROFILE (no personas activated - see 'ws-persona list') ...${c_reset}" >&2
    fi
else
    echo "${c_cyan}🏗️  workspaces-host-update: switching to $PROFILE ...${c_reset}" >&2
fi
home-manager switch --flake "$REPO#$PROFILE" --impure

echo >&2
echo "${c_cyan}🩺 workspaces-host-update: checking everything is OK ...${c_reset}" >&2
if command -v doctor >/dev/null 2>&1; then
    doctor || true
else
    echo "${c_yellow}⚠️  workspaces-host-update: 'doctor' isn't on PATH yet in this shell - open a new shell and run it.${c_reset}" >&2
fi
