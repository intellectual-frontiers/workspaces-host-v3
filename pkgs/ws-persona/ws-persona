#!/bin/sh
# ws-persona: discover, activate, and deactivate workspace personas.
# `activate`/`deactivate` only edit a small state file
# (~/.config/workspaces-host/personas) that flake.nix's `current` build
# reads - this command still never runs `nix build`/`home-manager
# switch` itself; applying a change is always the caller's own
# `workspaces-host-update`.
set -u

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_FILE="$CONFIG_HOME/workspaces-host/personas"

# Color only when it'll actually render as color: a real terminal, no
# NO_COLOR (https://no-color.org), and not the "dumb" fallback TERM -
# same convention as doctor/ws-repos.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    esc=$(printf '\033')
    c_reset="${esc}[0m"
    c_bold="${esc}[1m"
    c_dim="${esc}[2m"
    c_red="${esc}[31m"
    c_green="${esc}[32m"
    c_yellow="${esc}[33m"
    c_cyan="${esc}[36m"
else
    c_reset='' c_bold='' c_dim='' c_red='' c_green='' c_yellow='' c_cyan=''
fi

usage() {
    cat <<EOF
${c_bold}Usage:${c_reset} ws-persona <command> [persona]

Commands:
  list                Show every available persona, what it adds, and
                      the command to activate it.
  current             Show which personas are activated (recorded for
                      your next workspaces-host-update) and which look
                      active right now (detected on PATH).
  activate <persona>  Record a persona as activated. Combines with any
                      persona already activated - run
                      workspaces-host-update afterward to build it in.
  deactivate <persona> Remove a persona from your activated list. Run
                      workspaces-host-update afterward to build it out.

Personas combine: activate as many as you want, and every future
workspaces-host-update builds all of them together automatically.
EOF
}

# name:marker:description, one per persona. This table is the one
# place that has to stay in sync with home/profiles/*.nix and
# flake.nix's personaModules by hand - there's no machine-readable way
# to pull a persona's description or a good "is this active" marker
# command out of a .nix file without a Nix eval, and this command is
# meant to answer instantly with no flake evaluation at all.
personas() {
    cat <<'EOF'
backend:mvn:Java+Maven, PostgreSQL client, Redis, docker-compose, httpie
data:duckdb:python3, uv, duckdb
mobile:adb:android-tools (adb/fastboot), watchman
agent-ops:act:act, semtag/git-standup/git-extras, gopass, deno, llm
compliance:cnquery:osquery, cnquery, steampipe, openobserve, surveilr
networking:tailscale:Tailscale, Nebula
fish:fish:fish shell with matching aliases/prompt (making it your login shell is a separate, manual step)
EOF
}

is_known_persona() {
    personas | cut -d: -f1 | grep -qxF "$1"
}

cmd_list() {
    printf '%s🧩 Available personas:%s\n' "$c_bold" "$c_reset"
    echo
    personas | while IFS=: read -r name marker desc; do
        printf '  %s%-11s%s %s\n' "$c_bold$c_cyan" "$name" "$c_reset" "$desc"
        printf '              ws-persona activate %s\n' "$name"
        echo
    done
    echo "Personas combine: activate as many as you want, and 'current' builds all"
    echo "of them together on every future workspaces-host-update - no"
    echo "WORKSPACES_HOST_PROFILE to remember. Undo with 'ws-persona deactivate <name>'."
    echo
    echo "To try one persona once, without touching your activated list:"
    echo "  WORKSPACES_HOST_PROFILE=current-<name> workspaces-host-update"
}

cmd_current() {
    declared=""
    if [ -f "$STATE_FILE" ]; then
        declared=$(grep -v '^[[:space:]]*#' "$STATE_FILE" 2>/dev/null | grep -v '^[[:space:]]*$' || true)
    fi
    if [ -n "$declared" ]; then
        printf '%s✅ Activated (recorded in %s):%s\n' "$c_green" "$STATE_FILE" "$c_reset"
        printf '%s\n' "$declared" | sed 's/^/  /'
    else
        printf '%s⚪ No persona activated yet (%s does not list any).%s\n' "$c_dim" "$STATE_FILE" "$c_reset"
    fi
    echo
    detected=$(personas | while IFS=: read -r name marker desc; do
        if command -v "$marker" >/dev/null 2>&1; then
            printf '%s (detected via %s on PATH)\n' "$name" "$marker"
        fi
    done)
    if [ -n "$detected" ]; then
        printf '%s🔍 Detected right now, based on one marker tool per persona on PATH:%s\n' "$c_cyan" "$c_reset"
        printf '%s\n' "$detected" | sed 's/^/  /'
    else
        printf '%s⚪ No persona-specific marker tool found on PATH right now.%s\n' "$c_dim" "$c_reset"
    fi
    echo
    echo "Activated and detected can disagree right after you run activate or"
    echo "deactivate, until workspaces-host-update actually rebuilds - that's"
    echo "expected. Run 'doctor --all' for the full, authoritative picture."
}

cmd_activate() {
    name="${1:-}"
    [ -n "$name" ] || {
        echo "${c_red}Usage: ws-persona activate <persona>${c_reset}" >&2
        exit 1
    }
    if ! is_known_persona "$name"; then
        echo "${c_red}ws-persona: unknown persona '$name' - run 'ws-persona list' for valid names${c_reset}" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$STATE_FILE")"
    touch "$STATE_FILE"
    if grep -qxF "$name" "$STATE_FILE"; then
        printf '%s⚠️  ws-persona: '"'"'%s'"'"' is already activated%s\n' "$c_yellow" "$name" "$c_reset"
    else
        echo "$name" >>"$STATE_FILE"
        printf '%s✅ ws-persona: activated '"'"'%s'"'"' (recorded in %s)%s\n' "$c_green" "$name" "$STATE_FILE" "$c_reset"
    fi
    echo
    echo "Run workspaces-host-update to build it in - it combines with everything"
    echo "else you've activated, and every future workspaces-host-update keeps it."
}

cmd_deactivate() {
    name="${1:-}"
    [ -n "$name" ] || {
        echo "${c_red}Usage: ws-persona deactivate <persona>${c_reset}" >&2
        exit 1
    }
    if [ ! -f "$STATE_FILE" ] || ! grep -qxF "$name" "$STATE_FILE"; then
        printf '%s⚪ ws-persona: '"'"'%s'"'"' is not activated - nothing to do%s\n' "$c_dim" "$name" "$c_reset"
        exit 0
    fi
    tmp="$STATE_FILE.tmp.$$"
    grep -vxF "$name" "$STATE_FILE" >"$tmp"
    mv "$tmp" "$STATE_FILE"
    printf '%s✅ ws-persona: deactivated '"'"'%s'"'"' (removed from %s)%s\n' "$c_green" "$name" "$STATE_FILE" "$c_reset"
    echo
    echo "Run workspaces-host-update to rebuild without it."
}

[ $# -ge 1 ] || {
    usage >&2
    exit 1
}
cmd="$1"
shift
case "$cmd" in
list) cmd_list "$@" ;;
current) cmd_current "$@" ;;
activate) cmd_activate "$@" ;;
deactivate) cmd_deactivate "$@" ;;
-h | --help) usage ;;
*)
    echo "${c_red}ws-persona: unknown command: $cmd${c_reset}" >&2
    usage >&2
    exit 1
    ;;
esac
