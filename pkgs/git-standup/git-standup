#!/bin/sh
# git-standup: list this user's commits across one or more git repos since
# their last working day (or an explicit range), for daily standups.
set -eu

usage() {
    cat <<'EOF'
Usage: git-standup [-a AUTHOR] [-d DAYS] [-A] [DIR ...]

  -a AUTHOR   Filter by author (default: current git user.name/user.email)
  -d DAYS     How many days back to look (default: 1, or 3 over a weekend)
  -A          Show commits from all authors, not just the current user
  DIR ...     One or more directories to scan (default: current directory)

Each DIR is checked; if it is a git repository its log is shown, and if it
contains git repositories as immediate subdirectories those are shown too
(so it doubles as a "standup across all my projects" tool).
EOF
}

AUTHOR=""
DAYS=""
ALL_AUTHORS=false
DIRS=""

while [ $# -gt 0 ]; do
    case "$1" in
        -a) AUTHOR="$2"; shift 2 ;;
        -d) DAYS="$2"; shift 2 ;;
        -A) ALL_AUTHORS=true; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "git-standup: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *) DIRS="$DIRS $1"; shift ;;
    esac
done
DIRS="$DIRS $*"
[ -n "$(printf '%s' "$DIRS" | tr -d '[:space:]')" ] || DIRS="."

if [ -z "$DAYS" ]; then
    # Default to 1 day, but look back 3 days on a Monday so "since last
    # working day" covers the weekend.
    dow=$(date +%u)
    if [ "$dow" = "1" ]; then DAYS=3; else DAYS=1; fi
fi

since="$DAYS days ago"

log_one_repo() {
    repo="$1"
    printf '\n\033[1m%s\033[0m\n' "$repo"
    if [ "$ALL_AUTHORS" = true ]; then
        git -C "$repo" log --since="$since" --date=short \
            --pretty=format:'  %C(yellow)%h%Creset %ad %C(cyan)%an%Creset %s' || true
    else
        author="${AUTHOR:-$(git -C "$repo" config user.email 2>/dev/null || true)}"
        author="${author:-$(git -C "$repo" config user.name 2>/dev/null || true)}"
        if [ -z "$author" ]; then
            echo "  (no author configured; use -a or set user.name/user.email)" >&2
            return 0
        fi
        git -C "$repo" log --since="$since" --date=short --author="$author" \
            --pretty=format:'  %C(yellow)%h%Creset %ad %s' || true
    fi
    echo
}

for dir in $DIRS; do
    if [ -d "$dir/.git" ]; then
        log_one_repo "$dir"
        continue
    fi
    found=false
    for sub in "$dir"/*/; do
        [ -d "$sub/.git" ] || continue
        found=true
        log_one_repo "${sub%/}"
    done
    if [ "$found" = false ] && [ ! -d "$dir/.git" ]; then
        echo "git-standup: no git repositories found under $dir" >&2
    fi
done
