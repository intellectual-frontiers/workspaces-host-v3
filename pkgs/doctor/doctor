#!/bin/sh
# doctor: a slim health check for a workspaces-host-v3 provisioned
# environment. Prints one PASS/WARN/FAIL line per check (icon + colored
# label, color and icons auto-disabled for a non-terminal, NO_COLOR, or
# TERM=dumb); exits non-zero only if something FAILs (a WARN is
# informational, e.g. "you haven't set your git identity yet" rather than
# "the environment is broken").
#
# Default output is terse: only the checks that answer "did the install
# actually work" (Nix, shell, git, credentials, GitHub/GitLab auth,
# ws-repos). Everything else - common pitfalls, AI harness CLIs, every
# ported tool, and every persona-specific check (compliance, backend,
# agent-ops, networking) - is still *run* (so a real problem is never
# silently skipped) but only *printed* under `doctor --all`, since a
# freshly-installed base profile has none of those tools by design and
# doesn't need to be told so a dozen times. A FAIL is always printed
# immediately, in either mode - see fail() below.
set -u

# Color only when it'll actually render as color: a real terminal, no
# NO_COLOR (https://no-color.org), and not the "dumb" fallback TERM.
# printf's own \033 octal escape (not a bashism - POSIX printf(1)
# supports it) puts one real ESC byte in each variable; every one of
# them is the empty string, and every check below prints identically,
# when color is off.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    esc=$(printf '\033')
    c_reset="${esc}[0m"
    c_bold="${esc}[1m"
    c_dim="${esc}[2m"
    c_red="${esc}[31m"
    c_green="${esc}[32m"
    c_yellow="${esc}[33m"
    c_cyan="${esc}[36m"
    c_magenta="${esc}[35m"
else
    c_reset='' c_bold='' c_dim=''
    c_red='' c_green='' c_yellow='' c_cyan='' c_magenta=''
fi
c_bold_red="${c_bold}${c_red}"
c_bold_green="${c_bold}${c_green}"
c_bold_yellow="${c_bold}${c_yellow}"
c_bold_cyan="${c_bold}${c_cyan}"
c_bold_magenta="${c_bold}${c_magenta}"

RULE='────────────────────────────────────────────────────────'

ALL=0
case "${1:-}" in
-a | --all) ALL=1 ;;
-h | --help)
    cat <<EOF
${c_bold}Usage:${c_reset} doctor [--all]

  (no flag)   Show only the essential checks (Nix, shell, git,
              credentials, GitHub/GitLab auth, ws-repos), plus a
              pass/warn/fail summary.
  --all, -a   Show every check, including optional and persona-specific
              tooling (compliance, backend, agent-ops, networking).

Every check always runs in either mode - a real FAIL is never hidden,
even in the terse default output. Set NO_COLOR=1 to disable color.
EOF
    exit 0
    ;;
esac

FAILED=0
PASS_N=0
WARN_N=0
FAIL_N=0
# Set to 1 for a section that's only interesting once you've opted into
# something (a persona, an optional tool) - its PASS/WARN lines are
# hidden unless $ALL=1. A FAIL is never hidden, regardless.
QUIET=0

# Where a credential ends up as a plain file named after its own
# variable - see home/ai-harness.nix and workspaces-host-update. Used by
# both the GitHub/GitLab and AI-harness sections below.
secrets_env_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workspaces-host/secrets/env"

pass() {
    PASS_N=$((PASS_N + 1))
    [ "$QUIET" = 1 ] && [ "$ALL" != 1 ] && return
    printf '  %s✔ PASS%s  %s\n' "$c_green" "$c_reset" "$1"
}
warn() {
    WARN_N=$((WARN_N + 1))
    [ "$QUIET" = 1 ] && [ "$ALL" != 1 ] && return
    printf '  %s⚠ WARN%s  %s\n' "$c_yellow" "$c_reset" "$1"
}
fail() {
    FAIL_N=$((FAIL_N + 1))
    FAILED=1
    printf '  %s✖ FAIL%s  %s\n' "$c_red" "$c_reset" "$1"
}

# section TITLE QUIET_FLAG EMOJI: prints a colored "EMOJI TITLE" header,
# unless this section is quiet and we're not in --all mode. Also sets
# $QUIET for the checks that follow, so pass()/warn() inside this
# section know whether to print.
section() {
    QUIET="$2"
    if [ "$QUIET" != 1 ] || [ "$ALL" = 1 ]; then
        printf '\n%s%s %s%s\n' "$c_bold_cyan" "${3:-🔹}" "$1" "$c_reset"
    fi
}

check_cmd() {
    name="$1"
    label="${2:-$name}"
    if command -v "$name" >/dev/null 2>&1; then
        pass "$label is on PATH ($(command -v "$name"))"
    else
        fail "$label is NOT on PATH"
    fi
}

# optional_cmd NAME PERSONA: like check_cmd, but a missing command is a
# WARN pointing at the persona that provides it, never a FAIL - for tools
# this profile only installs when a persona is active.
optional_cmd() {
    name="$1"
    persona="$2"
    if command -v "$name" >/dev/null 2>&1; then
        pass "$name is on PATH ($(command -v "$name"))"
    else
        warn "$name is not on PATH (optional - activate the '$persona' persona if you want it)"
    fi
}

printf '\n%s🩺 workspaces-host doctor%s\n' "$c_bold_magenta" "$c_reset"
printf '%s%s%s\n' "$c_dim" "$RULE" "$c_reset"

section "Nix" 0 "❄️ "
if command -v nix >/dev/null 2>&1; then
    pass "nix is on PATH ($(nix --version 2>/dev/null | head -1))"
    if nix show-config 2>/dev/null | grep -q "experimental-features.*nix-command" && \
       nix show-config 2>/dev/null | grep -q "experimental-features.*flakes"; then
        pass "nix-command and flakes experimental features are enabled"
    else
        fail "nix-command/flakes experimental features are not both enabled (see README's install instructions)"
    fi
else
    fail "nix is NOT on PATH - none of the checks below can work without it"
fi
check_cmd home-manager

section "Shell / prompt / direnv" 0 "🐚"
check_cmd bash
check_cmd oh-my-posh
check_cmd direnv
check_cmd zoxide
check_cmd fzf
if command -v direnv >/dev/null 2>&1; then
    if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/direnv/lib/hm-nix-direnv.sh" ]; then
        pass "nix-direnv integration file present"
    else
        warn "nix-direnv integration file not found (did home-manager switch run?)"
    fi
fi
if [ -f "$HOME/.bashrc" ] && grep -q "blesh" "$HOME/.bashrc" 2>/dev/null; then
    pass "blesh (bash syntax highlighting/autosuggestions) is wired into ~/.bashrc"
else
    warn "blesh doesn't appear to be wired into ~/.bashrc (did home-manager switch run?)"
fi
if command -v getent >/dev/null 2>&1; then
    bash_path="$HOME/.nix-profile/bin/bash"
    fish_path="$HOME/.nix-profile/bin/fish"
    login_shell=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
    # $SHELL only reflects whatever shell you're actually running right
    # now (the system's own /bin/bash, if you're reading doctor's
    # output from a window opened before install.sh's chsh step ran) -
    # /etc/passwd's own field is the only reliable source for "what
    # will a brand-new window actually start in." Either this flake's
    # pinned bash or its pinned fish (the fish persona) counts as a
    # real answer - fish is an equally supported, deliberate choice
    # (see doctor's own "Alternative shell" section below), not
    # something to warn about just for not being bash.
    if [ "$login_shell" = "$bash_path" ]; then
        pass "this flake's own pinned bash ($bash_path) is your login shell"
    elif [ "$login_shell" = "$fish_path" ]; then
        pass "this flake's own pinned fish ($fish_path, the 'fish' persona) is your login shell"
    else
        warn "your login shell is $login_shell, not this flake's pinned bash ($bash_path) or fish ($fish_path) - install.sh tries to set bash automatically and may have failed (a locked-down /etc, no sudo); fix it yourself with 'chsh -s $bash_path', or for fish (if you've activated that persona) first run 'echo \"$fish_path\" | sudo tee -a /etc/shells' (chsh refuses a shell that isn't listed there) then 'chsh -s $fish_path' - if you want a shell this setup actually provisions"
    fi
fi

section "Git" 0 "🌿"
check_cmd git
if command -v git >/dev/null 2>&1; then
    email=$(git config --get user.email 2>/dev/null || true)
    case "$email" in
    "")
        warn "git user.email is not set"
        ;;
    *@example.invalid)
        warn "git user.email is still the placeholder ($email) - see README's 'Setting up your credentials' section"
        ;;
    *)
        pass "git user.email is set ($email)"
        ;;
    esac
    if command -v delta >/dev/null 2>&1; then
        if git config --get core.pager 2>/dev/null | grep -q delta; then
            pass "delta is wired in as git's diff pager"
        else
            warn "delta is installed but not set as git's pager (did home-manager switch run?)"
        fi
    fi
fi

section "Credentials file (~/.config/workspaces-host/credentials)" 0 "🔐"
credentials_file="${XDG_CONFIG_HOME:-$HOME/.config}/workspaces-host/credentials"
if [ -f "$credentials_file" ]; then
    cred_perm=$(stat -c '%a' "$credentials_file" 2>/dev/null || stat -f '%Lp' "$credentials_file" 2>/dev/null || echo '?')
    if [ "$cred_perm" = "600" ]; then
        pass "~/.config/workspaces-host/credentials exists with mode 600"
    else
        warn "~/.config/workspaces-host/credentials exists but mode is $cred_perm, not 600 - run 'workspaces-host-update' to fix it automatically"
    fi
else
    warn "~/.config/workspaces-host/credentials not found - run 'workspaces-host-update' once to create it from a template, then fill it in (see README's 'Setting up your credentials' section)"
fi

section "GitHub/GitLab authentication" 0 "🐙"
check_cmd gh
if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
        pass "gh is authenticated"
    elif [ -f "$secrets_env_dir/GITHUB_TOKEN" ] &&
        GITHUB_TOKEN="$(cat "$secrets_env_dir/GITHUB_TOKEN")" GH_TOKEN="$(cat "$secrets_env_dir/GITHUB_TOKEN")" \
            gh auth status >/dev/null 2>&1; then
        pass "gh is authenticated (via GITHUB_TOKEN in ~/.config/workspaces-host/credentials)"
    else
        warn "gh is not authenticated - add GITHUB_TOKEN to ~/.config/workspaces-host/credentials and run 'workspaces-host-update', or run 'gh auth login' directly"
    fi
fi
check_cmd glab
if command -v glab >/dev/null 2>&1; then
    if glab auth status >/dev/null 2>&1; then
        pass "glab is authenticated"
    elif [ -f "$secrets_env_dir/GITLAB_TOKEN" ] &&
        GITLAB_TOKEN="$(cat "$secrets_env_dir/GITLAB_TOKEN")" glab auth status >/dev/null 2>&1; then
        pass "glab is authenticated (via GITLAB_TOKEN in ~/.config/workspaces-host/credentials)"
    else
        warn "glab is not authenticated - add GITLAB_TOKEN to ~/.config/workspaces-host/credentials and run 'workspaces-host-update', or run 'glab auth login' directly, if you use GitLab"
    fi
fi

section "Workspace repo management (~/workspaces, ws-repos)" 0 "📁"
check_cmd ws-repos
check_cmd ws-persona
if [ -d "$HOME/workspaces" ]; then
    pass "~/workspaces exists"
    if [ -f "$HOME/workspaces/ws-repos.json" ]; then
        pass "~/workspaces/ws-repos.json exists (edit it to declare repos, then run 'ws-repos ensure')"
    else
        warn "~/workspaces/ws-repos.json not found (did home-manager switch run?)"
    fi
else
    warn "~/workspaces does not exist yet (did home-manager switch run?)"
fi

# --- Everything below is optional/persona-specific: hidden by default, -
# --- shown with `doctor --all`. A FAIL still always prints. -----------

section "Advanced: local.nix override (~/.config/workspaces-host/local.nix)" 1 "🧩"
if [ -f "$HOME/.config/workspaces-host/local.nix" ]; then
    pass "~/.config/workspaces-host/local.nix exists (personal Nix-level overrides live outside this repo, safe from every sync)"
else
    pass "~/.config/workspaces-host/local.nix not present (fine - it's only needed for advanced Nix-level customization; see local.nix.example)"
fi

section "Common pitfalls (SSH, WSL, disk, locale, plaintext creds)" 1 "🩹"

if [ -d "$HOME/.ssh" ]; then
    ssh_dir_perm=$(stat -c '%a' "$HOME/.ssh" 2>/dev/null || stat -f '%Lp' "$HOME/.ssh" 2>/dev/null || echo '?')
    if [ "$ssh_dir_perm" = "700" ]; then
        pass "~/.ssh exists with mode 700"
    else
        warn "~/.ssh exists but mode is $ssh_dir_perm, not 700 - ssh may refuse to use it (chmod 700 ~/.ssh)"
    fi
    found_key=0
    for key in "$HOME"/.ssh/id_*; do
        [ -f "$key" ] || continue
        case "$key" in
        *.pub) continue ;;
        esac
        found_key=1
        key_perm=$(stat -c '%a' "$key" 2>/dev/null || stat -f '%Lp' "$key" 2>/dev/null || echo '?')
        if [ "$key_perm" = "600" ] || [ "$key_perm" = "400" ]; then
            pass "$(basename "$key") exists with mode $key_perm"
        else
            warn "$(basename "$key") exists but mode is $key_perm, not 600 - ssh will refuse to use it (chmod 600 $key)"
        fi
    done
    [ "$found_key" = "1" ] || warn "no SSH private key found in ~/.ssh (id_ed25519, id_rsa, ...) - 'ssh-keygen -t ed25519' if you use SSH-based git remotes"
else
    warn "~/.ssh does not exist - 'ssh-keygen -t ed25519' if you use SSH-based git remotes"
fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    case "$HOME" in
    /mnt/*)
        warn "\$HOME ($HOME) is under /mnt - that's the Windows filesystem from inside WSL, which is much slower and has permissions quirks; keep your files on the Linux filesystem (e.g. under ~) instead"
        ;;
    *)
        pass "\$HOME is on the Linux filesystem, not a slower /mnt/* Windows mount"
        ;;
    esac
    # A correct $HOME doesn't guarantee every actual repo does too - the
    # WSL "I/O intensive operation like git" slowness warning happens
    # wherever you're actually standing when you run git, which is just
    # as often a project manually cloned/opened under /mnt/c (a habit
    # left over from before WSL, or a folder opened straight from
    # Windows Explorer) as it is a misconfigured $HOME.
    case "$PWD" in
    /mnt/*)
        warn "the current directory ($PWD) is under /mnt - that's the Windows filesystem from inside WSL, which is exactly what makes git (and other I/O-heavy commands) slow here; 'ws-repos ensure' clones repos under ~/workspaces (the Linux filesystem) instead - move or re-clone this one there"
        ;;
    *)
        pass "the current directory is on the Linux filesystem, not a slower /mnt/* Windows mount"
        ;;
    esac
fi

if command -v df >/dev/null 2>&1; then
    avail_kb=$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
    case "$avail_kb" in
    '' | *[!0-9]*) ;;
    *)
        if [ "$avail_kb" -lt 2097152 ]; then
            warn "less than 2 GiB free on the filesystem holding \$HOME - if /nix is on the same disk, try 'nix-collect-garbage -d'"
        else
            pass "disk space looks fine ($((avail_kb / 1048576)) GiB+ free)"
        fi
        ;;
    esac
fi

if command -v locale >/dev/null 2>&1 && locale 2>&1 | grep -qi "cannot set"; then
    warn "locale is misconfigured (locale(1) reports it cannot set LC_*) - common on a fresh Debian/WSL install; 'sudo apt install -y locales && sudo dpkg-reconfigure locales', or add 'export LANG=C.UTF-8' to your shell config"
else
    pass "locale looks configured correctly"
fi

if [ -f "$HOME/.netrc" ]; then
    netrc_perm=$(stat -c '%a' "$HOME/.netrc" 2>/dev/null || stat -f '%Lp' "$HOME/.netrc" 2>/dev/null || echo '?')
    if [ "$netrc_perm" != "600" ]; then
        warn "~/.netrc exists with mode $netrc_perm, not 600 - it likely holds plaintext credentials readable by others (chmod 600 ~/.netrc); prefer 'gh auth login' or a GITHUB_TOKEN in ~/.config/workspaces-host/credentials instead"
    else
        warn "~/.netrc exists - if it holds real credentials, prefer 'gh auth login' or ~/.config/workspaces-host/credentials over a hand-maintained ~/.netrc"
    fi
fi

current_umask=$(umask)
case "$current_umask" in
0000 | 000)
    warn "umask is $current_umask (new files are world-writable by default) - add 'umask 022' to your shell config"
    ;;
*)
    pass "umask is $current_umask"
    ;;
esac

if command -v docker >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ]; then
        pass "running as root (docker group membership doesn't apply)"
    elif id -nG 2>/dev/null | grep -qw docker; then
        pass "you're in the 'docker' group (docker commands don't need sudo)"
    else
        warn "docker is installed but you're not in the 'docker' group - 'sudo usermod -aG docker \$USER' then log out and back in avoids needing sudo for every docker command"
    fi
fi

section "AI harness CLIs & credentials" 1 "🤖"
check_ai_cli() {
    cli="$1"
    label="$2"
    key_vars="$3"
    if ! command -v "$cli" >/dev/null 2>&1; then
        warn "$label ($cli) is not installed - see README's 'Setting up AI harness credentials' section"
        return
    fi
    pass "$label is on PATH ($(command -v "$cli"))"
    # Credentials for these CLIs are deliberately NOT ambient env vars
    # (Constitution Principle III - resolved at the point of use only,
    # via a per-CLI bash wrapper function in home/ai-harness.nix), so
    # check for the secret file the wrapper reads, not $VARNAME itself -
    # an already-exported $VARNAME (e.g. from a project's own .envrc)
    # still counts too.
    for var in $key_vars; do
        eval "val=\${$var:-}"
        if [ -n "$val" ] || [ -f "$secrets_env_dir/$var" ]; then
            pass "$label: $var is available (checked env and $secrets_env_dir/)"
            return
        fi
    done
    warn "$label is installed but none of ($key_vars) is configured - add one to ~/.config/workspaces-host/credentials and run 'workspaces-host-update', or use the CLI's own 'login' command"
}
check_ai_cli claude "Claude Code" "ANTHROPIC_API_KEY"
check_ai_cli codex "OpenAI Codex CLI" "OPENAI_API_KEY"
check_ai_cli gemini "Gemini CLI" "GEMINI_API_KEY GOOGLE_API_KEY"
check_ai_cli aider "aider" "ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY"
if command -v gh >/dev/null 2>&1; then
    if gh extension list 2>/dev/null | grep -qi copilot; then
        pass "GitHub Copilot CLI extension is installed (gh extension list)"
    else
        warn "GitHub Copilot CLI extension not installed - 'gh extension install github/gh-copilot' if you want it"
    fi
fi

section "Ported CLI tools (home.packages)" 1 "🧰"
for c in rg fd jq bat eza gitleaks ws-repos ws-persona specify backlog scaffold-agent-harness sensitivectl git-xargs workspaces-host-update wget rclone git-chglog lefthook; do
    check_cmd "$c"
done

section "Agent-ops extras (optional persona)" 1 "🕹️ "
for c in semtag git-standup git-extras gopass deno llm; do
    optional_cmd "$c" agent-ops
done

section "Zero-trust networking clients (optional persona)" 1 "🌐"
optional_cmd tailscale networking
if command -v tailscale >/dev/null 2>&1; then
    pass "run 'sudo tailscale up' to join a tailnet"
fi
optional_cmd nebula networking
if command -v nebula >/dev/null 2>&1; then
    pass "nebula needs a CA-issued certificate from your mesh's admin to join"
fi

section "Alternative shell (optional persona: fish)" 1 "🐠"
optional_cmd fish fish
if command -v fish >/dev/null 2>&1; then
    pass "'echo \"\$(which fish)\" | sudo tee -a /etc/shells && chsh -s \$(which fish)' makes it your login shell (a separate, manual step - chsh refuses any shell not listed in /etc/shells first)"
fi

section "Sandbox sync (workspaces-host-update)" 1 "🔄"
if [ -n "${WORKSPACES_HOST_REPO:-}" ]; then
    if [ -d "$WORKSPACES_HOST_REPO/.git" ]; then
        pass "\$WORKSPACES_HOST_REPO ($WORKSPACES_HOST_REPO) is a git clone - 'workspaces-host-update' will work"
    else
        warn "\$WORKSPACES_HOST_REPO ($WORKSPACES_HOST_REPO) is not a git clone yet - clone workspaces-host-v3 there, or override the variable"
    fi
else
    warn "\$WORKSPACES_HOST_REPO is not set (did home-manager switch run?)"
fi

section "Compliance & observability tooling (optional persona)" 1 "📊"
if [ "$(uname -s)" = "Linux" ]; then
    optional_cmd osqueryi compliance
else
    warn "osquery is Linux-only (nixpkgs meta.platforms) - not installed on $(uname -s)"
fi
optional_cmd cnquery compliance
optional_cmd steampipe compliance
optional_cmd openobserve compliance
optional_cmd surveilr compliance

section "PostgreSQL credentials (optional persona: backend)" 1 "🐘"
if command -v pgpass >/dev/null 2>&1; then
    pass "pgpass is on PATH ($(command -v pgpass))"
    if [ -f "$HOME/.pgpass" ]; then
        perm=$(stat -c '%a' "$HOME/.pgpass" 2>/dev/null || stat -f '%Lp' "$HOME/.pgpass" 2>/dev/null || echo '?')
        if [ "$perm" = "600" ]; then
            pass "~/.pgpass exists with mode 600 (edit it to add connections, then use 'pgpass')"
        else
            warn "~/.pgpass exists but mode is $perm, not 600 (libpq/psql may ignore it - chmod 600 ~/.pgpass)"
        fi
    else
        warn "~/.pgpass not found (did home-manager switch run?)"
    fi
    if [ -f "$HOME/.psqlrc" ]; then
        pass "~/.psqlrc exists"
    else
        warn "~/.psqlrc not found (did home-manager switch run?)"
    fi
else
    warn "pgpass is not on PATH (optional - activate the 'backend' persona if you use Postgres)"
fi

section "Java toolchain (optional persona: backend)" 1 "☕"
if command -v java >/dev/null 2>&1; then
    pass "java is on PATH ($(command -v java))"
    pass "java $(java -version 2>&1 | head -1)"
    check_cmd mvn
    if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
        pass "JAVA_HOME is set and valid ($JAVA_HOME)"
    else
        warn "JAVA_HOME is not set or not valid (did home-manager switch run?)"
    fi
else
    warn "java is not on PATH (optional - activate the 'backend' persona if you use Java)"
fi

section "Optional: container tooling (spec 005)" 1 "🐳"
if command -v docker >/dev/null 2>&1; then
    pass "docker is on PATH (needed to run packages.<system>.oci-image*)"
else
    warn "docker is not on PATH (only needed to run the OCI images this flake builds, not for the host profile itself)"
fi

printf '\n%s%s%s\n' "$c_dim" "$RULE" "$c_reset"
printf '  %s✔ %d passed%s   %s⚠ %d warnings%s   %s✖ %d failed%s\n' \
    "$c_green" "$PASS_N" "$c_reset" \
    "$c_yellow" "$WARN_N" "$c_reset" \
    "$c_red" "$FAIL_N" "$c_reset"
if [ "$ALL" != 1 ]; then
    printf "  %srun 'doctor --all' for the full report, including persona-specific and optional checks%s\n" "$c_dim" "$c_reset"
fi
if [ "$FAILED" = "1" ]; then
    printf '\n%s✖ doctor: one or more checks FAILED - see above%s\n' "$c_bold_red" "$c_reset"
    exit 1
else
    printf '\n%s✔ doctor: all checks passed (WARNs, if any, are informational)%s\n' "$c_bold_green" "$c_reset"
    exit 0
fi
